# Database connection string
DATABASE_URL="postgresql://myshop_user:myshop_password@localhost:5432/myshop_db"

# Port the API listens on
PORT=5000

# Secret used to sign JWTs (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="myshop-development-secret-change-me-1234567890"

# Token lifetime
JWT_EXPIRES_IN="1d"

# Allowed frontend origin (CORS)
CLIENT_URL="http://localhost:5173"

# Whether POST /auth/register works (true or false)
ALLOW_REGISTRATION="true"

# First Admin account, created by prisma/seed.ts
SEED_ADMIN_EMAIL="admin@myshop.com"
SEED_ADMIN_PASSWORD="adminpass123"